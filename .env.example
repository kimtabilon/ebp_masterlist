# =============================================================================
# EBP Masterlist Pipeline — Environment Variables
# Copy to .env and fill in values. App refuses to start if required vars missing.
# =============================================================================

# --- MongoDB (required) ---
MONGO_HOST=64.225.124.70
MONGO_PORT=27018
MONGO_USER=
MONGO_PASS=

# --- MySQL (legacy sync — optional) ---
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASS=
MYSQL_DB=ecomm_ebp_test

# --- SFTP Credentials ---
SYNNEX_FTP_HOST=
SYNNEX_FTP_USER=
SYNNEX_FTP_PASS=

DANDH_SFTP_HOST=
DANDH_FTP_USER=
DANDH_FTP_PASS=

INGRAM_SFTP_HOST=
INGRAM_FTP_USER=
INGRAM_FTP_PASS=

SUPPLIESNETWORK_SFTP_HOST=
SUPPLIESNETWORK_SFTP_USER=
SUPPLIESNETWORK_SFTP_PASSWORD=

# --- Distributor API Credentials ---
SYNNEX_API_USER=
SYNNEX_API_PASS=

DANDH_API_USER=
DANDH_API_PASS=

INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=

# --- File Paths (defaults usually fine; absolute paths supported) ---
# RAW_DIR=master_list/raw
# BUFFER_DIR=src/raw
# MANUFACTURER_MAP_PATH=src/raw/manufacturer report.xlsx
# ALMO_FILE_PATH=master_list/raw/almo.xlsx

# --- Pipeline Thresholds ---
# BUILD_BATCH_SIZE=1000     # SKUs per streaming build batch (higher may help on localhost DB)
# INSERT_BATCH_SIZE=50000   # Docs per insertMany in merge stage (default was 20000)
# SYNNEX_BATCH_SIZE=50      # SKUs per Synnex API call (tested: 10-100, sweet spot is 50)

# --- Validation Thresholds ---
# VALIDATION_COUNT_THRESHOLD_PCT=10
# VALIDATION_MAX_INVENTORY_MULTIPLIER=100
# VALIDATION_COVERAGE_MISMATCH_PCT=1
# VALIDATION_ZERO_PRICE_PCT=8        # ~4.5% baseline in prod; 8% gives ~2x headroom
# VALIDATION_UPC_INVALID_PCT=1       # UPC check accepts 11-14 digits (11 = leading-zero-stripped UPC-A)
# VALIDATION_SKU_UPC_CHANGED=500     # 500 gives safety on first-run cutover; tighten after observing prod behavior
# VALIDATION_DISABLED_CHECKS=

# --- Diff Thresholds ---
# DIFF_PRICE_CHANGE_PCT=10
# DIFF_INVENTORY_CHANGE_PCT=50

# --- Alerting ---
ALERT_SLACK_WEBHOOK_URL=

# --- Webhook URLs ---
# WEBHOOK_UPDATE_INVENTORY=https://console.ecommercebusinessprime.com/api/marketplace/updateInventory
# WEBHOOK_UPDATE_WALMART=https://console.ecommercebusinessprime.com/api/marketplace/updateWalmartInventory
# WEBHOOK_UPDATE_NEWEGG=https://console.ecommercebusinessprime.com/api/newegg/updateInventory

# --- Logging ---
# LOG_FORMAT=human  # "json" for structured, "human" for readable

# --- API Endpoint Auth ---
API_KEY=

# --- Test Mode ---
# DB_NAME_OVERRIDE=master_list_test
